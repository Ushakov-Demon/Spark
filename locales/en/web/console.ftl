## The lab's command console.

console-which-one = Which one
console-unknown-word = I don't know "{ $what }". Run the command without words to see the list.
console-also-named = Also
console-help-title = Commands (Tab completes, ↑/↓ — history):
console-actions = Actions:
console-substances = Substances:
console-substance-stays = The substance stays during an experiment — "reset" first.
console-vessels = Vessels:
console-vessel-stays = The vessel stays during an experiment — "reset" first.
console-devices = Devices:
console-setpoint-range = {" "}(range { $min }…{ $max } °C)
console-no-heater = ✓ no heater, in the room
console-no-knob = There is no knob here.
console-no-target = This action has no target temperature.
console-no-duration = This action runs to its goal, not by time.
console-running-already = The experiment is running — "reset" first.
console-lid-on = ✓ with a lid
console-lid-off = ✓ no lid
console-voices = Voices (voice <name>):
console-started = ▶ running!
console-presets = Ready-made experiments (preset <number>):
console-grade = grade
console-report-below = ✓ see the report below
console-records = Recordings (replay <number>):
console-newspaper = 📰 The Professor is looking for a newspaper…
console-scenes = Scenes (prof <name>):
console-greet = Lab console. Type "help" to see the commands.
console-placeholder = e.g. action freeze
console-no-command = No command "{ $head }". Type "help".
console-help-usage = help [command]
console-help-about = the list of commands or one of them
console-actions-usage = actions
console-actions-about = what can be done
console-action-usage = action <name>
console-action-about = choose an action: action freeze
console-substances-usage = substances
console-substances-about = substances for the chosen action
console-substance-usage = substance <name> [amount L|mL|g]
console-substance-about = pour a substance: substance sea 0.5 L
console-vessels-usage = vessels
console-vessels-about = vessels that fit the device
console-vessel-usage = vessel <name> [size L] [material]
console-vessel-about = choose a vessel: vessel beaker 0.25
console-devices-usage = devices
console-devices-about = devices for the chosen action
console-device-usage = device <name> [W | °C | V]
console-device-about = a device and its setting: device freezer -22
console-knob-usage = knob <0…100 %>
console-knob-about = turn the heater or power supply knob
console-target-usage = target <°C>
console-target-about = the temperature to heat or cool to
console-duration-usage = duration <min>
console-duration-about = how many minutes the action runs (current)
console-temp-usage = temp <°C>
console-temp-about = starting temperature of the substance
console-room-usage = room <°C>
console-room-about = room temperature
console-lid-usage = lid on|off
console-lid-about = put a lid on
console-add-usage = add <substance> <mass g> [°C] [frozen]
console-add-about = add something: add salt 7 g
console-weigh-usage = weigh [kitchen | lab]
console-weigh-about = put the vessel on the scales: weigh lab
console-voice-usage = voice [toon | speech | none]
console-voice-about = the Professor’s voice: voice none
console-level-usage = level
console-level-about = read the marks: the volume of the liquid (measuring cylinder)
console-hang-usage = hang <body> <mass g> [air | water]
console-hang-about = hang a body on the dynamometer: hang aluminium 100 g water
console-start-usage = start
console-start-about = start (or continue) the experiment
console-pause-usage = pause
console-pause-about = stop the clock
console-reset-usage = reset
console-reset-about = start the experiment over
console-speed-usage = speed <1…3600>
console-speed-about = how many times faster than real time
console-status-usage = status
console-status-about = what the readouts show now
console-predict-usage = predict <min>
console-predict-about = my prediction: in how many minutes
console-info-usage = info <name>
console-info-about = reference card of a substance or device
console-presets-usage = presets
console-presets-about = ready-made experiments with numbers
console-preset-usage = preset <number or name>
console-preset-about = start a ready-made experiment
console-explain-usage = explain
console-explain-about = what happened and why
console-save-usage = save [name]
console-save-about = save the experiment (all steps) as a recording
console-records-usage = records
console-records-about = my recordings with numbers
console-replay-usage = replay <number>
console-replay-about = replay a recording step by step
console-news-usage = news
console-news-about = "By the way!.." — the Professor's newspaper: a curious fact or a page of history
console-prof-usage = prof [scene]
console-prof-about = the Professor's scenes: prof coffee
console-clear-usage = clear
console-clear-about = clear the console
