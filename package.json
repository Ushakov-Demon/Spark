{
  "name": "spark",
  "version": "0.1.0",
  "private": true,
  "description": "Physics sandbox engine for school students (UI-agnostic core)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx examples/kettle-cli.ts",
    "knowledge:report": "tsx scripts/knowledge-report.ts",
    "experiment": "tsx examples/kettle-experiment.ts",
    "lab": "tsx examples/mixing-lab.ts",
    "boil": "tsx examples/boil.ts",
    "web": "vite",
    "web:build": "vite build && tsx scripts/build-site.ts",
    "web:offline": "vite build --mode single"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
